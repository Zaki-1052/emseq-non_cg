#!/bin/bash
# scripts/sections/slurm/40_01_dmr_marks.sb
#SBATCH --job-name=sec_40_01
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=48:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/40_01_dmr_marks_%j.out

# Section 40_01: permutation of mCH gene bodies against chromatin marks.
#
# Runs scripts/sections/40_permutation/40_01_dmr_marks.R.
# Writes into results/sections/40_permutation/.
#
# The permutation count comes from the NTIMES variable, so it can be raised
# without editing this file:
#     NTIMES=20000 sbatch scripts/sections/slurm/40_01_dmr_marks.sb
#
# The section caches its permutation objects as RDS and reuses them. Set
# FORCE_RERUN to recompute:
#     FORCE_RERUN=1 sbatch scripts/sections/slurm/40_01_dmr_marks.sb
#
# Usage: sbatch scripts/sections/slurm/40_01_dmr_marks.sb

echo "========================================="
echo "EM-seq section 40_01: gene body x mark permutation"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${CODEDIR}/results/sections/40_permutation"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/40_permutation/40_01_dmr_marks.R"
NTIMES="${NTIMES:-5000}"

echo "Code dir:       $CODEDIR"
echo "Data dir:       $DATADIR"
echo "Script:         $SECTION_SCRIPT"
echo "Output dir:     $OUTDIR"
echo "Cores:          ${SLURM_CPUS_PER_TASK}"
echo "Randomisations: ${NTIMES}"

if [[ -n "${FORCE_RERUN:-}" ]]; then
    export FORCE_RERUN
    echo "FORCE_RERUN=${FORCE_RERUN}: the permutation cache is recomputed."
else
    echo "FORCE_RERUN not set: an existing permutation cache is reused."
fi
echo ""

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR" "$NTIMES"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 40_01"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
