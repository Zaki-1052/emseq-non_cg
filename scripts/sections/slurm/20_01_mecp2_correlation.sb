#!/bin/bash
# scripts/sections/slurm/20_01_mecp2_correlation.sb
#SBATCH --job-name=sec_20_01
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/20_chip_integration/20_01_mecp2_correlation_%j.out

# Section 20_01: MeCP2 correlation.
#
# Runs scripts/sections/20_chip_integration/20_01_mecp2_correlation.R.
# Writes into results/sections/20_chip_integration/ and registers Fisher tests
# in results/sections/fisher_test_registry.tsv, which section 40_04 validates.
#
# Usage: sbatch scripts/sections/slurm/20_01_mecp2_correlation.sb

echo "========================================="
echo "EM-seq section 20_01: MeCP2 correlation"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${CODEDIR}/results/sections/20_chip_integration"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/20_chip_integration/20_01_mecp2_correlation.R"

echo "Code dir:   $CODEDIR"
echo "Data dir:   $DATADIR"
echo "Script:     $SECTION_SCRIPT"
echo "Output dir: $OUTDIR"
echo ""

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 20_01"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
