#!/bin/bash
# scripts/sections/slurm/40_04_gene_level.sb
#SBATCH --job-name=sec_40_04
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=128G
#SBATCH --time=24:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/40_permutation/40_04_gene_level_%j.out

# Section 40_04: label-shuffle validation of every registered Fisher test.
#
# Runs scripts/sections/40_permutation/40_04_gene_level.R.
# Reads results/sections/fisher_test_registry.tsv, which every section that
# registers a gene-level Fisher test appends to. This section runs last.
# Writes into results/sections/40_permutation/.
#
# The shuffle count comes from the NTIMES variable, so it can be raised
# without editing this file:
#     NTIMES=50000 sbatch scripts/sections/slurm/40_04_gene_level.sb
#
# The section caches its permutation objects as RDS and reuses them. Set
# FORCE_RERUN to recompute:
#     FORCE_RERUN=1 sbatch scripts/sections/slurm/40_04_gene_level.sb
#
# Usage: sbatch scripts/sections/slurm/40_04_gene_level.sb

echo "========================================="
echo "EM-seq section 40_04: gene-level label permutation"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${CODEDIR}/results/sections/40_permutation"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/40_permutation/40_04_gene_level.R"
FISHER_REGISTRY="${CODEDIR}/results/sections/fisher_test_registry.tsv"
NTIMES="${NTIMES:-10000}"

echo "Code dir:        $CODEDIR"
echo "Data dir:        $DATADIR"
echo "Script:          $SECTION_SCRIPT"
echo "Output dir:      $OUTDIR"
echo "Fisher registry: $FISHER_REGISTRY"
echo "Cores:           ${SLURM_CPUS_PER_TASK}"
echo "Label shuffles:  ${NTIMES}"

if [[ -n "${FORCE_RERUN:-}" ]]; then
    export FORCE_RERUN
    echo "FORCE_RERUN=${FORCE_RERUN}: the permutation cache is recomputed."
else
    echo "FORCE_RERUN not set: an existing permutation cache is reused."
fi
echo ""

if [[ ! -s "$FISHER_REGISTRY" ]]; then
    echo "ERROR: Fisher test registry not found: $FISHER_REGISTRY"
    echo "Sections 10_01, 10_02, 10_03, 20_01, 20_02, 30_01, 30_02, 60_01,"
    echo "60_02, 60_04, 70_01, and 70_03 append to this registry. Run them first."
    exit 1
fi

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR" "$NTIMES"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 40_04"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
