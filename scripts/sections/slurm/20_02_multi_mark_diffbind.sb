#!/bin/bash
# scripts/sections/slurm/20_02_multi_mark_diffbind.sb
#SBATCH --job-name=sec_20_02
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/20_02_multi_mark_diffbind_%j.out

# Section 20_02: multi-mark DiffBind.
#
# Runs scripts/sections/20_chip_integration/20_02_multi_mark_diffbind.R.
# Reads the gene_chromatin_state.tsv handoff from section 10_01.
# Writes into results/sections/20_chip_integration/, including the handoff
# table gene_level_all_marks.tsv that sections 20_03, 20_04, 70_02, and 70_04
# read.
#
# Usage: sbatch scripts/sections/slurm/20_02_multi_mark_diffbind.sb

echo "========================================="
echo "EM-seq section 20_02: multi-mark DiffBind"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${DATADIR}/results/sections/20_chip_integration"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/20_chip_integration/20_02_multi_mark_diffbind.R"
CHROMATIN_STATE="${DATADIR}/results/sections/10_chromatin/gene_chromatin_state.tsv"

echo "Code dir:        $CODEDIR"
echo "Data dir:        $DATADIR"
echo "Script:          $SECTION_SCRIPT"
echo "Output dir:      $OUTDIR"
echo "Chromatin state: $CHROMATIN_STATE"
echo ""

if [[ ! -s "$CHROMATIN_STATE" ]]; then
    echo "ERROR: chromatin state handoff not found: $CHROMATIN_STATE"
    echo "Section 10_01 (10_01_chromatin_state) writes this file. Run it first."
    exit 1
fi

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 20_02"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
