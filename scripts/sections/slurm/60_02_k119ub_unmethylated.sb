#!/bin/bash
# scripts/sections/slurm/60_02_k119ub_unmethylated.sb
#SBATCH --job-name=sec_60_02
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/60_02_k119ub_unmethylated_%j.out

# Section 60_02: K119ub at unmethylated MeCP2 genes.
#
# Runs scripts/sections/60_mecp2/60_02_k119ub_unmethylated.R.
# Reads the mecp2_no_meth_genes.tsv handoff from section 60_01.
# Writes into results/sections/60_mecp2/.
#
# Usage: sbatch scripts/sections/slurm/60_02_k119ub_unmethylated.sb

echo "========================================="
echo "EM-seq section 60_02: K119ub unmethylated"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${CODEDIR}/results/sections/60_mecp2"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/60_mecp2/60_02_k119ub_unmethylated.R"
NO_METH_GENES="${CODEDIR}/results/sections/60_mecp2/mecp2_no_meth_genes.tsv"

echo "Code dir:          $CODEDIR"
echo "Data dir:          $DATADIR"
echo "Script:            $SECTION_SCRIPT"
echo "Output dir:        $OUTDIR"
echo "MeCP2 no-meth set: $NO_METH_GENES"
echo ""

if [[ ! -s "$NO_METH_GENES" ]]; then
    echo "ERROR: MeCP2 unmethylated gene handoff not found: $NO_METH_GENES"
    echo "Section 60_01 (60_01_methylation_scale) writes this file. Run it first."
    exit 1
fi

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 60_02"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
