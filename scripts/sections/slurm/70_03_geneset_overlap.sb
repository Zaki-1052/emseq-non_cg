#!/bin/bash
# scripts/sections/slurm/70_03_geneset_overlap.sb
#SBATCH --job-name=sec_70_03
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/70_neuronal/70_03_geneset_overlap_%j.out

# Section 70_03: gene set overlap.
#
# Runs scripts/sections/70_neuronal/70_03_geneset_overlap.R.
# Reads the neuronal_gene_set.tsv handoff from section 70_01.
# Writes into results/sections/70_neuronal/ and registers Fisher tests in
# results/sections/fisher_test_registry.tsv, which section 40_04 validates.
#
# Usage: sbatch scripts/sections/slurm/70_03_geneset_overlap.sb

echo "========================================="
echo "EM-seq section 70_03: gene set overlap"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${CODEDIR}/results/sections/70_neuronal"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/70_neuronal/70_03_geneset_overlap.R"
NEURONAL_GENES="${CODEDIR}/results/sections/70_neuronal/neuronal_gene_set.tsv"

echo "Code dir:       $CODEDIR"
echo "Data dir:       $DATADIR"
echo "Script:         $SECTION_SCRIPT"
echo "Output dir:     $OUTDIR"
echo "Neuronal genes: $NEURONAL_GENES"
echo ""

if [[ ! -s "$NEURONAL_GENES" ]]; then
    echo "ERROR: neuronal gene set handoff not found: $NEURONAL_GENES"
    echo "Section 70_01 (70_01_k119ub_neuronal) writes this file. Run it first."
    exit 1
fi

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 70_03"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
