#!/bin/bash
# scripts/sections/slurm/50_01_feature_methylation.sb
#SBATCH --job-name=sec_50_01
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=04:00:00
#SBATCH --account=csd940
#SBATCH --output=logs/sections/50_01_feature_methylation_%j.out

# Section 50_01: sub-gene feature methylation.
#
# Runs scripts/sections/50_features/50_01_feature_methylation.R.
# Reads the eight per-sample tables in results/02b_features/, written by
# scripts/02b_mch_aggregate_features.sb.
# Writes into results/sections/50_features/.
#
# Usage: sbatch scripts/sections/slurm/50_01_feature_methylation.sb

echo "========================================="
echo "EM-seq section 50_01: feature methylation"
echo "========================================="
echo "Job ID: ${SLURM_JOB_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

# Environment variables do not persist across jobs, so activate every time.
source ~/.bashrc
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

export EMSEQ_ENV=expanse

CODEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq-repo"
DATADIR="/expanse/lustre/projects/csd940/zalibhai/emseq"

# Lustre scratch inside the data directory. System temp directories are
# unreliable here.
export TMPDIR="${DATADIR}/.scratch/${SLURM_JOB_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

LOGDIR="${CODEDIR}/logs/sections"
OUTDIR="${CODEDIR}/results/sections/50_features"
mkdir -p "$LOGDIR" "$OUTDIR"

SECTION_SCRIPT="${CODEDIR}/scripts/sections/50_features/50_01_feature_methylation.R"
FEATURE_DIR="${CODEDIR}/results/02b_features"
SAMPLES=(ctrl_M1 ctrl_M2 ctrl_F1 ctrl_F2 mut_M1 mut_M2 mut_F1 mut_F2)

echo "Code dir:    $CODEDIR"
echo "Data dir:    $DATADIR"
echo "Script:      $SECTION_SCRIPT"
echo "Output dir:  $OUTDIR"
echo "Feature dir: $FEATURE_DIR"
echo ""

if [[ ! -d "$FEATURE_DIR" ]]; then
    echo "ERROR: step 02b output directory not found: $FEATURE_DIR"
    echo "Run scripts/02b_mch_aggregate_features.sb first. It writes one"
    echo "feature table per sample as an 8-task array job."
    exit 1
fi

MISSING=()
for SAMPLE in "${SAMPLES[@]}"; do
    if [[ ! -s "${FEATURE_DIR}/${SAMPLE}_feature_mch.tsv" ]]; then
        MISSING+=("${SAMPLE}_feature_mch.tsv")
    fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
    echo "ERROR: ${#MISSING[@]} of ${#SAMPLES[@]} per-sample feature tables are missing in $FEATURE_DIR"
    printf '  %s\n' "${MISSING[@]}"
    echo "Run scripts/02b_mch_aggregate_features.sb first. It writes one"
    echo "feature table per sample as an 8-task array job."
    exit 1
fi

echo "All ${#SAMPLES[@]} per-sample feature tables are present."
echo ""

START=$(date +%s)

Rscript "$SECTION_SCRIPT" --output-dir "$OUTDIR"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: section 50_01"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
exit $EXIT_CODE
