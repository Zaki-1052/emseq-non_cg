#!/bin/bash
# scripts/ca/03_ca_aggregate.sb
#SBATCH --job-name=mca_agg
#SBATCH --partition=shared
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --time=48:00:00
#SBATCH --account=csd940
#SBATCH --array=0-7
#SBATCH --output=logs/mca_aggregate_%A_%a.out

# Aggregate CA-only methylation over gene bodies per sample.
# Uses the same mch_aggregate_sample.R as the all-CH pipeline.
#
# Input:  combined_ca/{sample}_CA.methylKit.gz
# Output: results/ca/02_aggregate/aggregated/{sample}_genebody_mch.tsv + {sample}_lambda.tsv
#
# Usage: sbatch --dependency=afterok:<COMBINE_CA_JOBID> run_mca_aggregate.sb

echo "========================================="
echo "EM-seq: Gene-body mCA aggregation"
echo "========================================="
echo "Job ID: ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "Node: $HOSTNAME"
echo "Start time: $(date)"
echo "========================================="
echo ""

BASEDIR="/expanse/lustre/projects/csd940/zalibhai/emseq"
export TMPDIR="${BASEDIR}/.scratch/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$TMPDIR"
echo "TMPDIR=$TMPDIR"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate emseq_env

SAMPLES=(ctrl_M1 mut_M1 ctrl_F1 mut_F1 ctrl_M2 mut_M2 ctrl_F2 mut_F2)
SAMPLE="${SAMPLES[$SLURM_ARRAY_TASK_ID]}"

SCRIPT_DIR="${BASEDIR}/scripts"
CH_FILE="${BASEDIR}/combined_ca/${SAMPLE}_CA.methylKit.gz"
GENE_BED="${BASEDIR}/references/gene_bodies.protein_coding.bed"
OUTDIR="${BASEDIR}/results/ca/02_aggregate/aggregated"

echo "Sample:   $SAMPLE"
echo "CA file:  $CH_FILE"
echo "Gene BED: $GENE_BED"
echo "Out dir:  $OUTDIR"
echo ""

if [[ ! -s "$CH_FILE" ]]; then
    echo "ERROR: CA file not found: $CH_FILE"
    exit 1
fi

mkdir -p "$OUTDIR"

START=$(date +%s)

Rscript "${SCRIPT_DIR}/02_mch_aggregate_sample.R" \
    --sample-id "$SAMPLE" \
    --ch-file "$CH_FILE" \
    --gene-bed "$GENE_BED" \
    --out-dir "$OUTDIR" \
    --threads "$SLURM_CPUS_PER_TASK"

EXIT_CODE=$?
END=$(date +%s)

echo ""
echo "========================================="
echo "Complete: $SAMPLE"
echo "Time: $((END - START))s"
echo "Exit code: $EXIT_CODE"
echo "End time: $(date)"
echo "========================================="
